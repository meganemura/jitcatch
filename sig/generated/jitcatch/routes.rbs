module JitCatch
  # Reads the routes `config/routes.rb` draws as source, without booting the
  # app, so a request a test sends to a path or a path helper names the
  # controller action that serves it. It reads `resources`, `resource`,
  # `namespace`, `scope`, `member`, `collection`, `root`, and a verb with
  # `to:`, `=>`, or `controller:` and `action:`, and names helpers and
  # controllers with the app's inflections. A route that a `draw` file, a
  # loop, or a concern draws is not read, so its helper stays unknown.
  class Routes
    class Route < Data
      attr_reader verb(): String

      attr_reader path(): String

      attr_reader helper(): String?

      attr_reader action(): String

      def self.new: (String verb, String path, String? helper, String action) -> instance
                  | (verb: String, path: String, helper: String?, action: String) -> instance

      def self.members: () -> [ :verb, :path, :helper, :action ]

      def members: () -> [ :verb, :path, :helper, :action ]
    end

    # `resource` is the resource whose block the statements are in: the
    # path and helper of one member, and its controller. `controller` is
    # the one `scope controller:` names.
    class Scope < Data
      attr_reader path(): String

      attr_reader helper(): String

      attr_reader modules(): Array[String]

      attr_reader resource(): Resource?

      attr_reader controller(): String?

      def self.new: (String path, String helper, Array[String] modules, Resource? resource, String? controller) -> instance
                  | (path: String, helper: String, modules: Array[String], resource: Resource?, controller: String?) -> instance

      def self.members: () -> [ :path, :helper, :modules, :resource, :controller ]

      def members: () -> [ :path, :helper, :modules, :resource, :controller ]
    end

    class Resource < Data
      attr_reader member_path(): String

      attr_reader collection_path(): String

      attr_reader member_helper(): String

      attr_reader collection_helper(): String

      attr_reader controller(): String

      def self.new: (String member_path, String collection_path, String member_helper, String collection_helper, String controller) -> instance
                  | (member_path: String, collection_path: String, member_helper: String, collection_helper: String, controller: String) -> instance

      def self.members: () -> [ :member_path, :collection_path, :member_helper, :collection_helper, :controller ]

      def members: () -> [ :member_path, :collection_path, :member_helper, :collection_helper, :controller ]
    end

    # An action `resources` or `resource` draws: its name, its verb, its
    # path after the collection's, and the kind of helper that names it.
    type drawn_action = [ Symbol, String, String, Symbol ]

    VERBS: Array[Symbol]

    # The actions `resources` draws, in the order Rails matches them: the
    # verb, the path after the collection's, and whether the helper names
    # the collection, a member, or the member with a prefix.
    PLURAL_ACTIONS: Array[drawn_action]

    SINGULAR_ACTIONS: Array[drawn_action]

    # Blocks whose routes keep the scope around them.
    PASS_THROUGH: Array[Symbol]

    @routes: Array[Route]

    @inflections: Inflections

    # : (String? source, ?Inflections inflections) -> Routes
    def self.parse: (String? source, ?Inflections inflections) -> Routes

    # : (Inflections inflections) -> void
    def initialize: (Inflections inflections) -> void

    # : (String action) -> bool
    def drawn?: (String action) -> bool

    # : (String name) -> bool
    def helper?: (String name) -> bool

    # The first route a `*_path` or `*_url` helper builds a URL for, or nil.
    # : (String name) -> Route?
    def route_for_helper: (String name) -> Route?

    # The controller actions a request (`POST things_path`, or
    # `GET /things/7`, `*` for a segment the test computes) reaches: by
    # helper, each action that helper serves for the verb; by path, the
    # first route Rails would match, a computed segment preferring a
    # `:param` to a literal one.
    # : (String request) -> Array[String]
    def actions: (String request) -> Array[String]

    # A path the app serves itself, so the request names every segment of
